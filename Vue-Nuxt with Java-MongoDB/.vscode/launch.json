{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Nuxt App",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Spring Boot-BasketballMicroserviceApplication<basketball-microservice>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.nba.basketball_microservice.BasketballMicroserviceApplication",
            "projectName": "basketball-microservice",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}